{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["ES2017", "DOM", "DOM.Iterable"],
        "module": "ES2015",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "es",
        "rootDir": "src",
        "skipLibCheck": true
    },
    "include": ["src"]
}
