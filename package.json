{
    "name": "@ax-design/navigation",
    "version": "0.2.1",
    "description": "Web component that implement Navigation Indicator animation of Axiom Design System.",
    "main": "build/main.js",
    "module": "es/index.js",
    "typings": "es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ax-design/navigation.git"
    },
    "homepage": "https://github.com/ax-design/navigation#readme",
    "bugs": {
        "url": "https://github.com/ax-design/navigation/issues"
    },
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "@types/bezier-easing": "^2.1.6",
        "@types/bun": "latest",
        "playwright": "^1.64.1",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "bun test",
        "test:browser": "bun test-browser/run.ts",
        "demo": "bun demo/serve.ts",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@ax-design/shape": "^0.3.0",
        "@ax-design/surface": "^0.4.1",
        "@ax-design/typed-om": "^0.3.0",
        "bezier-easing": "^2.1.0"
    },
    "files": [
        "build",
        "es",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "source": "./src/index.ts",
            "import": "./es/index.js",
            "require": "./build/main.js",
            "default": "./es/index.js"
        },
        "./package.json": "./package.json"
    }
}
